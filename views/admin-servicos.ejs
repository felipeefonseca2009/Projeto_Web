<%- include('partials/header') %>
<%- include('partials/admin-nav', { active: 'servicos' }) %>

<main class="admin-page container">
    <header class="admin-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> Operação</p><h1>Serviços</h1><p>Atendimentos e seus dados de execução.</p></div></header>
    <section class="admin-section admin-section-first">
        <div class="admin-table-wrap"><table class="admin-table">
            <thead><tr><th>Data</th><th>Status</th><th>Cliente</th><th>Veículo</th><th>Problema</th><th>Mecânico</th><th>Preço</th><th>Pagamento</th></tr></thead>
            <tbody>
                <% servicos.forEach((servico) => { %>
                    <tr>
                        <td><%= new Date(servico.data_servico).toLocaleDateString('pt-BR') %></td>
                        <td><span class="status-pill status-<%= (servico.status_solicitacao || 'SEM_SOLICITACAO').toLowerCase() %>"><%= (servico.status_solicitacao || 'Sem solicitação').replace('_', ' ') %></span></td>
                        <td><%= servico.cliente %></td><td><%= servico.modelo %><small><%= servico.placa %></small></td>
                        <td><%= servico.descricao_problema || 'Descrição não registrada' %></td><td><%= servico.mecanico %></td>
                        <td><%= Number(servico.preco_servico).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></td><td><%= servico.forma_pagamento %></td>
                    </tr>
                <% }) %>
                <% if (servicos.length === 0) { %><tr><td colspan="8">Nenhum serviço registrado.</td></tr><% } %>
            </tbody>
        </table></div>
    </section>
</main>

<%- include('partials/footer') %>