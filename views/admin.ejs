<%- include('partials/header') %>

<main class="admin-page container">
    <header class="admin-heading">
        <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> Gestão da oficina</p>
            <h1>Painel administrativo</h1>
            <p>Solicitações, equipe e serviços em um só lugar.</p>
        </div>
        <form action="/admin/logout" method="POST">
            <button class="button button-small" type="submit">Sair</button>
        </form>
    </header>

    <% if (mensagem) { %>
        <div class="admin-notice <%= erro ? 'admin-notice-error' : '' %>" role="<%= erro ? 'alert' : 'status' %>"><%= mensagem %></div>
    <% } %>

    <section class="admin-stats" aria-label="Resumo">
        <div class="admin-stat"><span>Solicitações pendentes</span><strong><%= resumo.pendentes %></strong></div>
        <div class="admin-stat"><span>Clientes</span><strong><%= resumo.clientes %></strong></div>
        <div class="admin-stat"><span>Veículos</span><strong><%= resumo.veiculos %></strong></div>
        <div class="admin-stat"><span>Serviços</span><strong><%= resumo.servicos %></strong></div>
    </section>

    <section class="admin-section" aria-labelledby="solicitacoes-title">
        <h2 id="solicitacoes-title">Solicitações pendentes</h2>
        <% if (solicitacoes.length === 0) { %>
            <p class="admin-empty">Não há solicitações pendentes.</p>
        <% } %>

        <% solicitacoes.forEach((solicitacao) => { %>
            <article class="admin-request">
                <div class="admin-request-summary">
                    <div>
                        <strong><%= solicitacao.nome %></strong>
                        <span><%= solicitacao.telefone %></span>
                        <span>Recebida em <%= new Date(solicitacao.data_solicitacao).toLocaleString('pt-BR') %></span>
                    </div>
                    <div>
                        <strong><%= solicitacao.modelo_veiculo %></strong>
                        <span>Placa: <%= solicitacao.placa %></span>
                    </div>
                    <p><%= solicitacao.descricao_problema %></p>
                </div>

                <details class="admin-process">
                    <summary>Converter em atendimento</summary>
                    <% if (mecanicos.length === 0) { %>
                        <p class="admin-empty">Cadastre um mecânico antes de abrir o serviço.</p>
                    <% } else { %>
                        <form class="admin-form" action="/admin/solicitacoes/<%= solicitacao.id_solicitacao %>/processar" method="POST">
                            <div class="form-field">
                                <label for="email-<%= solicitacao.id_solicitacao %>">E-mail do cliente</label>
                                <input type="email" id="email-<%= solicitacao.id_solicitacao %>" name="email" maxlength="100" required>
                            </div>
                            <div class="form-field">
                                <label for="marca-<%= solicitacao.id_solicitacao %>">Marca</label>
                                <input type="text" id="marca-<%= solicitacao.id_solicitacao %>" name="marca" maxlength="30" required>
                            </div>
                            <div class="form-field">
                                <label for="modelo-<%= solicitacao.id_solicitacao %>">Modelo</label>
                                <input type="text" id="modelo-<%= solicitacao.id_solicitacao %>" name="modelo" maxlength="50" required>
                            </div>
                            <div class="form-field">
                                <label for="ano-<%= solicitacao.id_solicitacao %>">Ano</label>
                                <input type="number" id="ano-<%= solicitacao.id_solicitacao %>" name="ano" min="1900" max="2100" required>
                            </div>
                            <div class="form-field">
                                <label for="mecanico-<%= solicitacao.id_solicitacao %>">Mecânico</label>
                                <select id="mecanico-<%= solicitacao.id_solicitacao %>" name="id_mecanico" required>
                                    <option value="">Selecione</option>
                                    <% mecanicos.forEach((mecanico) => { %>
                                        <option value="<%= mecanico.id_mecanico %>"><%= mecanico.nome %><%= mecanico.especialidade ? ` - ${mecanico.especialidade}` : '' %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-field">
                                <label for="preco-<%= solicitacao.id_solicitacao %>">Preço previsto (R$)</label>
                                <input type="number" id="preco-<%= solicitacao.id_solicitacao %>" name="preco_servico" min="0.01" max="99999999.99" step="0.01" required>
                            </div>
                            <div class="form-field">
                                <label for="pagamento-<%= solicitacao.id_solicitacao %>">Pagamento</label>
                                <select id="pagamento-<%= solicitacao.id_solicitacao %>" name="forma_pagamento" required>
                                    <option value="">Selecione</option>
                                    <option value="A DEFINIR">A definir</option>
                                    <option value="PIX">Pix</option>
                                    <option value="Cartão de crédito">Cartão de crédito</option>
                                    <option value="Cartão de débito">Cartão de débito</option>
                                    <option value="Dinheiro">Dinheiro</option>
                                    <option value="Transferência">Transferência</option>
                                </select>
                            </div>
                            <button class="button" type="submit">Criar atendimento</button>
                        </form>
                    <% } %>
                </details>
            </article>
        <% }) %>
    </section>

    <section class="admin-section" aria-labelledby="mecanicos-title">
        <h2 id="mecanicos-title">Mecânicos</h2>
        <form class="admin-mechanic-form" action="/admin/mecanicos" method="POST">
            <div class="form-field">
                <label for="mecanico-nome">Nome</label>
                <input type="text" id="mecanico-nome" name="nome" maxlength="100" required>
            </div>
            <div class="form-field">
                <label for="mecanico-telefone">Telefone</label>
                <input type="tel" id="mecanico-telefone" name="telefone" maxlength="20" required>
            </div>
            <div class="form-field">
                <label for="mecanico-email">E-mail</label>
                <input type="email" id="mecanico-email" name="email" maxlength="100" required>
            </div>
            <div class="form-field">
                <label for="mecanico-especialidade">Especialidade</label>
                <input type="text" id="mecanico-especialidade" name="especialidade" maxlength="50">
            </div>
            <button class="button" type="submit">Cadastrar mecânico</button>
        </form>

        <div class="admin-table-wrap admin-subsection">
            <table class="admin-table">
                <thead><tr><th>Nome</th><th>Especialidade</th></tr></thead>
                <tbody>
                    <% mecanicos.forEach((mecanico) => { %>
                        <tr><td><%= mecanico.nome %></td><td><%= mecanico.especialidade || 'Não informada' %></td></tr>
                    <% }) %>
                    <% if (mecanicos.length === 0) { %>
                        <tr><td colspan="2">Nenhum mecânico cadastrado.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin-section" aria-labelledby="servicos-title">
        <h2 id="servicos-title">Serviços recentes</h2>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Data</th><th>Cliente</th><th>Veículo</th><th>Mecânico</th><th>Preço</th><th>Pagamento</th></tr></thead>
                <tbody>
                    <% servicos.forEach((servico) => { %>
                        <tr>
                            <td><%= new Date(servico.data_servico).toLocaleDateString('pt-BR') %></td>
                            <td><%= servico.cliente %></td>
                            <td><%= servico.modelo %><small><%= servico.placa %></small></td>
                            <td><%= servico.mecanico %></td>
                            <td><%= Number(servico.preco_servico).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></td>
                            <td><%= servico.forma_pagamento %></td>
                        </tr>
                    <% }) %>
                    <% if (servicos.length === 0) { %>
                        <tr><td colspan="6">Nenhum serviço registrado.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin-section" aria-labelledby="clientes-title">
        <h2 id="clientes-title">Clientes recentes</h2>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Nome</th><th>Telefone</th><th>E-mail</th></tr></thead>
                <tbody>
                    <% clientes.forEach((cliente) => { %>
                        <tr><td><%= cliente.nome %></td><td><%= cliente.telefone %></td><td><%= cliente.email %></td></tr>
                    <% }) %>
                    <% if (clientes.length === 0) { %>
                        <tr><td colspan="3">Nenhum cliente cadastrado.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin-section" aria-labelledby="veiculos-title">
        <h2 id="veiculos-title">Veículos recentes</h2>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Placa</th><th>Veículo</th><th>Ano</th><th>Cliente</th></tr></thead>
                <tbody>
                    <% veiculos.forEach((veiculo) => { %>
                        <tr><td><%= veiculo.placa %></td><td><%= veiculo.marca %> <%= veiculo.modelo %></td><td><%= veiculo.ano %></td><td><%= veiculo.cliente %></td></tr>
                    <% }) %>
                    <% if (veiculos.length === 0) { %>
                        <tr><td colspan="4">Nenhum veículo cadastrado.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>
</main>

<%- include('partials/footer') %>