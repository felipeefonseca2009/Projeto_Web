<%- include('partials/header') %>
<%- include('partials/admin-nav', { active: 'clientes' }) %>

<main class="admin-page container">
    <header class="admin-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> Cadastros</p><h1>Clientes</h1><p>Contatos vinculados aos atendimentos da oficina.</p></div></header>
    <section class="admin-section admin-section-first">
        <div class="admin-table-wrap"><table class="admin-table">
            <thead><tr><th>Nome</th><th>CPF</th><th>Telefone</th><th>E-mail</th></tr></thead>
            <tbody>
                <% clientes.forEach((cliente) => { %><tr><td><%= cliente.nome %></td><td><%= cliente.cpf || 'Não informado' %></td><td><%= cliente.telefone %></td><td><%= cliente.email %></td></tr><% }) %>
                <% if (clientes.length === 0) { %><tr><td colspan="4">Nenhum cliente cadastrado.</td></tr><% } %>
            </tbody>
        </table></div>
    </section>
</main>

<%- include('partials/footer') %>