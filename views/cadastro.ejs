<%- include('partials/header') %>

<main class="auth-page container">
    <section class="auth-panel" aria-labelledby="signup-title">
        <p class="eyebrow"><span class="eyebrow-line"></span> Cadastro de cliente</p>
        <h1 id="signup-title">Crie sua conta</h1>
        <p>Cadastre-se para solicitar atendimento e registrar os dados do seu veículo.</p>

        <% if (erro) { %>
            <div class="notice notice-error" role="alert">Não foi possível criar a conta. Confira o CPF, os dados ou tente entrar se o e-mail já estiver cadastrado.</div>
        <% } %>

        <form class="auth-form" action="/cadastro" method="POST">
            <div class="form-field">
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="nome" autocomplete="name" maxlength="100" required>
            </div>
            <div class="form-field">
                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" autocomplete="email" maxlength="100" required>
            </div>
            <div class="form-field">
                <label for="cpf">CPF</label>
                <input type="text" id="cpf" name="cpf" inputmode="numeric" autocomplete="off" maxlength="14" placeholder="000.000.000-00" pattern="\d{3}\.?\d{3}\.?\d{3}-?\d{2}" required>
            </div>
            <div class="form-field">
                <label for="senha">Senha (mínimo 12 caracteres)</label>
                <input type="password" id="senha" name="senha" autocomplete="new-password" minlength="12" maxlength="72" required>
            </div>
            <button class="button" type="submit">Criar conta</button>
        </form>
        <p class="auth-alternative">Já tem cadastro? <a href="/login">Entrar</a></p>
    </section>
</main>

<%- include('partials/footer') %>
